# Copy to .env (never commit it). The Android app never sees these values.
KITE_API_KEY=
KITE_API_SECRET=
# Bearer token the Android app sends as `Authorization: Bearer <token>`
APP_API_TOKEN=change-me-to-a-long-random-string
DATABASE_URL=sqlite:///./nifty_engine.db
# paper | live   (live additionally requires LIVE_TRADING_ENABLED=true)
EXECUTION_MODE=paper
LIVE_TRADING_ENABLED=false
# manual = every live order needs approval from the app; auto = engine places orders itself
APPROVAL_MODE=manual
# synthetic | kite
DATA_SOURCE=synthetic
CAPITAL=500000
